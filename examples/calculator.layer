# Interactive Calculator
# Full-featured calculator with digit pad and display

@layers [core, ui]

@layer core {
    # Basic arithmetic operations
    fn add(a, b) = a + b
    fn subtract(a, b) = a - b
    fn multiply(a, b) = a * b
    fn divide(a, b) =
        match b with
        | 0 -> "Error: Division by zero"
        | _ -> a / b

    # Advanced operations
    fn square(n) = n * n
    fn percent(n) = n / 100

    # Calculator utilities
    fn clear() = "0"
}

@layer ui {
    fn calculator() =
        view({
            title: "Calculator",
            children: [
                text({content: "Calculator"}),

                # Display
                input({name: "display", placeholder: "0", width: "280px"}),

                # Calculator keypad (4 rows)
                row([
                    button({label: "7", onclick: "7"}),
                    button({label: "8", onclick: "8"}),
                    button({label: "9", onclick: "9"}),
                    button({label: "÷", onclick: "divide(display, 1)"})
                ]),
                row([
                    button({label: "4", onclick: "4"}),
                    button({label: "5", onclick: "5"}),
                    button({label: "6", onclick: "6"}),
                    button({label: "×", onclick: "multiply(display, 1)"})
                ]),
                row([
                    button({label: "1", onclick: "1"}),
                    button({label: "2", onclick: "2"}),
                    button({label: "3", onclick: "3"}),
                    button({label: "-", onclick: "subtract(display, 0)"})
                ]),
                row([
                    button({label: "0", onclick: "0"}),
                    button({label: ".", onclick: "."}),
                    button({label: "x²", onclick: "square(display)"}),
                    button({label: "+", onclick: "add(display, 0)"})
                ]),

                # Operations row
                row([
                    button({label: "%", onclick: "percent(display)"}),
                    button({label: "C", onclick: "clear()"}),
                    button({label: "=", onclick: "display"})
                ]),

                # Two-number operations
                text({content: "Two-Number Operations:"}),
                row([
                    input({name: "num1", placeholder: "First", width: "130px"}),
                    input({name: "num2", placeholder: "Second", width: "130px"})
                ]),
                row([
                    button({label: "num1 + num2", onclick: "add(num1, num2)"}),
                    button({label: "num1 - num2", onclick: "subtract(num1, num2)"}),
                    button({label: "num1 × num2", onclick: "multiply(num1, num2)"}),
                    button({label: "num1 ÷ num2", onclick: "divide(num1, num2)"})
                ])
            ]
        })
}

# Main expression
render(calculator())

# Interactive Calculator
# Full-featured calculator with digit pad and display

@layers [core, ui]

@layer core {
    # Append digit to display (string concatenation)
    fn append_digit(display, digit) =
        match display with
        | "" -> digit
        | "0" -> digit
        | _ -> display + digit

    # Append operator to display with spaces
    fn append_operator(display, op) =
        match display with
        | "" -> "0 " + op + " "
        | _ -> display + " " + op + " "

    # Evaluate expression in display
    # Handles multi-operation expressions like "14 + 2 - 7 * 3"
    # Note: Evaluates left-to-right without operator precedence for simplicity
    fn evaluate(expr) =
        let parts = split(" ", expr) in
        eval_parts(parts)

    # Recursively evaluate list of tokens
    fn eval_parts(parts) =
        match parts with
        | [] -> "0"
        | [a] -> a
        | [a, "+", b, ...rest] ->
            let result = to_string(to_float(a) + to_float(b)) in
            eval_parts([result, ...rest])
        | [a, "-", b, ...rest] ->
            let result = to_string(to_float(a) - to_float(b)) in
            eval_parts([result, ...rest])
        | [a, "*", b, ...rest] ->
            let result = to_string(to_float(a) * to_float(b)) in
            eval_parts([result, ...rest])
        | [a, "/", b, ...rest] ->
            let result = match to_float(b) with
                | 0.0 -> "Error"
                | _ -> to_string(to_float(a) / to_float(b)) in
            eval_parts([result, ...rest])
        | _ -> "Error"

    # Calculator operations that work on display strings
    # These convert the display string to number, apply operation, convert back
    fn calc_square(display) =
        match display with
        | "" -> "0"
        | _ -> to_string(to_float(display) * to_float(display))

    fn calc_percent(display) =
        match display with
        | "" -> "0"
        | _ -> to_string(to_float(display) / 100)

    # Two-number arithmetic operations
    fn calc_add(a, b) = to_string(to_float(a) + to_float(b))
    fn calc_subtract(a, b) = to_string(to_float(a) - to_float(b))
    fn calc_multiply(a, b) = to_string(to_float(a) * to_float(b))
    fn calc_divide(a, b) =
        match to_float(b) with
        | 0.0 -> "Error"
        | _ -> to_string(to_float(a) / to_float(b))

    # Calculator utilities
    fn clear() = "0"
}

@layer ui {
    fn calculator() =
        view({
            title: "Calculator",
            children: [
                text({content: "Calculator"}),

                # Display
                input({name: "display", placeholder: "0", width: "280px"}),

                # Calculator keypad with operators
                row([
                    button({label: "7", onclick: "append_digit(display, '7')"}),
                    button({label: "8", onclick: "append_digit(display, '8')"}),
                    button({label: "9", onclick: "append_digit(display, '9')"}),
                    button({label: "÷", onclick: "append_operator(display, '/')"}),
                    button({label: "C", onclick: "clear()"})
                ]),
                row([
                    button({label: "4", onclick: "append_digit(display, '4')"}),
                    button({label: "5", onclick: "append_digit(display, '5')"}),
                    button({label: "6", onclick: "append_digit(display, '6')"}),
                    button({label: "×", onclick: "append_operator(display, '*')"}),
                    button({label: "x²", onclick: "calc_square(display)"})
                ]),
                row([
                    button({label: "1", onclick: "append_digit(display, '1')"}),
                    button({label: "2", onclick: "append_digit(display, '2')"}),
                    button({label: "3", onclick: "append_digit(display, '3')"}),
                    button({label: "-", onclick: "append_operator(display, '-')"}),
                    button({label: "%", onclick: "calc_percent(display)"})
                ]),
                row([
                    button({label: "0", onclick: "append_digit(display, '0')"}),
                    button({label: ".", onclick: "append_digit(display, '.')"}),
                    button({label: "=", onclick: "evaluate(display)"}),
                    button({label: "+", onclick: "append_operator(display, '+')"}),
                    button({label: " ", onclick: "display"})
                ]),

                # Two-number operations
                text({content: "Two-Number Operations:"}),
                row([
                    input({name: "num1", placeholder: "First number", width: "130px"}),
                    input({name: "num2", placeholder: "Second number", width: "130px"})
                ]),
                row([
                    button({label: "num1 + num2", onclick: "calc_add(num1, num2)"}),
                    button({label: "num1 - num2", onclick: "calc_subtract(num1, num2)"}),
                    button({label: "num1 × num2", onclick: "calc_multiply(num1, num2)"}),
                    button({label: "num1 ÷ num2", onclick: "calc_divide(num1, num2)"})
                ])
            ]
        })
}

# Main expression
render(calculator())

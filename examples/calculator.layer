# Interactive Calculator — an app: the model is the display text
#
# Every key sends a message ({digit: "7"}, {op: "*"}, "equals", ...); update
# turns the message into a new display; the view shows it. The arithmetic
# helpers below are ordinary pure functions.

@layers [core, ui]

@layer core {
    fn init() = {display: "0"}

    fn update(msg, model) =
        match msg with
        | {digit: d} -> {model | display: append_digit(model.display, d)}
        | {op: o}    -> {model | display: append_operator(model.display, o)}
        | "equals"   -> {model | display: evaluate(model.display)}
        | "square"   -> {model | display: calc_square(model.display)}
        | "percent"  -> {model | display: calc_percent(model.display)}
        | "clear"    -> init()

    # Append digit to display (string concatenation)
    fn append_digit(display, digit) =
        match display with
        | "" -> digit
        | "0" -> digit
        | _ -> display + digit

    # Append operator to display with spaces
    fn append_operator(display, op) =
        match display with
        | "" -> "0 " + op + " "
        | _ -> display + " " + op + " "

    # Evaluate expression in display
    # Handles multi-operation expressions like "14 + 2 - 7 * 3"
    # Note: Evaluates left-to-right without operator precedence for simplicity
    fn evaluate(expr) =
        let parts = split(" ", expr) in
        eval_parts(parts)

    # Recursively evaluate list of tokens (without using ellipsis syntax)
    fn eval_parts(parts) =
        let len = length(parts) in
        match len with
        | 0 -> "0"
        | 1 -> head(parts)
        | _ ->
            let a = head(parts) in
            let rest1 = tail(parts) in
            let op = head(rest1) in
            let rest2 = tail(rest1) in
            let b = head(rest2) in
            let remaining = tail(rest2) in
            let result = match op with
                | "+" -> to_string(to_float(a) + to_float(b))
                | "-" -> to_string(to_float(a) - to_float(b))
                | "*" -> to_string(to_float(a) * to_float(b))
                | "/" ->
                    match to_float(b) with
                    | 0.0 -> "Error"
                    | _ -> to_string(to_float(a) / to_float(b))
                | _ -> "Error"
            in
            eval_parts(concat([result], remaining))

    # Calculator operations that work on display strings
    # These convert the display string to number, apply operation, convert back
    fn calc_square(display) =
        match display with
        | "" -> "0"
        | _ -> to_string(to_float(display) * to_float(display))

    fn calc_percent(display) =
        match display with
        | "" -> "0"
        | _ -> to_string(to_float(display) / 100)
}

@layer ui {
    fn key(label, msg) = button({label: label, on_click: msg})
    fn digit(d) = key(d, {digit: d})
    fn op(label, o) = key(label, {op: o})

    fn calculator(model) =
        view({
            title: "Calculator",
            children: [
                text({content: model.display}),
                row([digit("7"), digit("8"), digit("9"), op("÷", "/"), key("C", "clear")]),
                row([digit("4"), digit("5"), digit("6"), op("×", "*"), key("x²", "square")]),
                row([digit("1"), digit("2"), digit("3"), op("-", "-"), key("%", "percent")]),
                row([digit("0"), digit("."), key("=", "equals"), op("+", "+")])
            ]
        })
}

app({init: init(), update: update, view: calculator})

# Send: {digit: "7"}
# Send: {op: "*"}
# Send: {digit: "6"}
# Send: "equals"
# Model: {display: "42"}

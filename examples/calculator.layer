# Interactive Calculator
# Full-featured calculator with digit pad and display

@layers [core, ui]

@layer core {
    # Append digit to display (string concatenation)
    fn append_digit(display, digit) =
        match display with
        | "" -> digit
        | "0" -> digit
        | _ -> display + digit

    # Append operator to display with spaces
    fn append_operator(display, op) =
        match display with
        | "" -> "0 " + op + " "
        | _ -> display + " " + op + " "

    # Evaluate expression in display
    # Handles multi-operation expressions like "14 + 2 - 7 * 3"
    # Note: Evaluates left-to-right without operator precedence for simplicity
    fn evaluate(expr) =
        let parts = split(" ", expr) in
        eval_parts(parts)

    # Recursively evaluate list of tokens (without using ellipsis syntax)
    fn eval_parts(parts) =
        let len = length(parts) in
        match len with
        | 0 -> "0"
        | 1 -> head(parts)
        | _ ->
            let a = head(parts) in
            let rest1 = tail(parts) in
            let op = head(rest1) in
            let rest2 = tail(rest1) in
            let b = head(rest2) in
            let remaining = tail(rest2) in
            let result = match op with
                | "+" -> to_string(to_float(a) + to_float(b))
                | "-" -> to_string(to_float(a) - to_float(b))
                | "*" -> to_string(to_float(a) * to_float(b))
                | "/" ->
                    match to_float(b) with
                    | 0.0 -> "Error"
                    | _ -> to_string(to_float(a) / to_float(b))
                | _ -> "Error"
            in
            eval_parts(concat([result], remaining))

    # Calculator operations that work on display strings
    # These convert the display string to number, apply operation, convert back
    fn calc_square(display) =
        match display with
        | "" -> "0"
        | _ -> to_string(to_float(display) * to_float(display))

    fn calc_percent(display) =
        match display with
        | "" -> "0"
        | _ -> to_string(to_float(display) / 100)

    # Two-number arithmetic operations
    fn calc_add(a, b) = to_string(to_float(a) + to_float(b))
    fn calc_subtract(a, b) = to_string(to_float(a) - to_float(b))
    fn calc_multiply(a, b) = to_string(to_float(a) * to_float(b))
    fn calc_divide(a, b) =
        match to_float(b) with
        | 0.0 -> "Error"
        | _ -> to_string(to_float(a) / to_float(b))

    # Calculator utilities
    fn clear() = "0"
}

@layer ui {
    fn calculator() =
        view({
            title: "Calculator",
            children: [
                text({content: "Calculator"}),

                # Display
                input({name: "display", placeholder: "0", width: "280px"}),

                # Calculator keypad with operators
                row([
                    button({label: "7", onclick: "append_digit(display, '7')", target: "display"}),
                    button({label: "8", onclick: "append_digit(display, '8')", target: "display"}),
                    button({label: "9", onclick: "append_digit(display, '9')", target: "display"}),
                    button({label: "÷", onclick: "append_operator(display, '/')", target: "display"}),
                    button({label: "C", onclick: "clear()", target: "display"})
                ]),
                row([
                    button({label: "4", onclick: "append_digit(display, '4')", target: "display"}),
                    button({label: "5", onclick: "append_digit(display, '5')", target: "display"}),
                    button({label: "6", onclick: "append_digit(display, '6')", target: "display"}),
                    button({label: "×", onclick: "append_operator(display, '*')", target: "display"}),
                    button({label: "x²", onclick: "calc_square(display)", target: "display"})
                ]),
                row([
                    button({label: "1", onclick: "append_digit(display, '1')", target: "display"}),
                    button({label: "2", onclick: "append_digit(display, '2')", target: "display"}),
                    button({label: "3", onclick: "append_digit(display, '3')", target: "display"}),
                    button({label: "-", onclick: "append_operator(display, '-')", target: "display"}),
                    button({label: "%", onclick: "calc_percent(display)", target: "display"})
                ]),
                row([
                    button({label: "0", onclick: "append_digit(display, '0')", target: "display"}),
                    button({label: ".", onclick: "append_digit(display, '.')", target: "display"}),
                    button({label: "=", onclick: "evaluate(display)", target: "display"}),
                    button({label: "+", onclick: "append_operator(display, '+')", target: "display"}),
                    button({label: " ", onclick: "display", target: "display"})
                ]),

                # Two-number operations
                text({content: "Two-Number Operations:"}),
                row([
                    input({name: "num1", placeholder: "First number", width: "130px"}),
                    input({name: "num2", placeholder: "Second number", width: "130px"})
                ]),
                row([
                    button({label: "num1 + num2", onclick: "calc_add(num1, num2)"}),
                    button({label: "num1 - num2", onclick: "calc_subtract(num1, num2)"}),
                    button({label: "num1 × num2", onclick: "calc_multiply(num1, num2)"}),
                    button({label: "num1 ÷ num2", onclick: "calc_divide(num1, num2)"})
                ])
            ]
        })
}

# Main expression
render(calculator())

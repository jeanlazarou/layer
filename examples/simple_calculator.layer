# Simple Calculator — an app with two number inputs
#
# The model holds both operands and the last result. Typing in an input
# sends {a: number} or {b: number}; each button sends {op: name}; update
# computes the result.

@layers [core, ui]

@layer core {
    fn init() = {a: 0, b: 0, result: ""}

    fn compute(op, a, b) =
        match op with
        | "add"      -> to_string(a + b)
        | "subtract" -> to_string(a - b)
        | "multiply" -> to_string(a * b)
        | "divide"   -> if b == 0 then "Error: division by zero" else to_string(a / b)

    fn update(msg, model) =
        match msg with
        | {a: x}   -> {model | a: x}
        | {b: x}   -> {model | b: x}
        | {op: op} -> {model | result: compute(op, model.a, model.b)}
}

@layer ui {
    fn calculator(model) =
        view({
            title: "Simple Calculator",
            children: [
                text("Enter two numbers and pick an operation:"),
                row([
                    input({name: "a", label: "First number", type: "number", value: model.a, on_input: "a"}),
                    input({name: "b", label: "Second number", type: "number", value: model.b, on_input: "b"})
                ]),
                row([
                    button({label: "Add", on_click: {op: "add"}}),
                    button({label: "Subtract", on_click: {op: "subtract"}}),
                    button({label: "Multiply", on_click: {op: "multiply"}}),
                    button({label: "Divide", on_click: {op: "divide"}})
                ]),
                text("Result: {model.result}")
            ]
        })
}

app({init: init(), update: update, view: calculator})

# Send: {a: 6}
# Send: {b: 7}
# Send: {op: "multiply"}
# Model: {a: 6, b: 7, result: "42"}
